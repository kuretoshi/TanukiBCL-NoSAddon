"role.tanukiBitCharacter.name" : "Bit Character"
"role.tanukiBitCharacter.short" : "BIT"
"role.tanukiBitCharacter.blurb" : "Evolve through the ages"
"options.role.tanukiBitCharacter.detail" : "Your appearance and voice evolve over time."
"role.tanukiBitCharacter.doc" : "Your appearance and voice evolve over time.<br>Progress through 2, 4, 8, 16, 32 and 64-bit styles. After the 64-bit duration ends, restore your original outfit and voice.<br>Meetings pause progression and restore normal voice."
"role.tanukiBitCharacter.tips" : "・Each stage lasts 5-180 seconds (default 30).<br>・Death and exile scenes also pause the timer.<br>・Hero transformations take costume priority.<br>・2-bit is grayscale; later stages follow your crew color.<br>・Bit labels describe an artistic effect.<br>・Voice effects require the matching development build of TanukiBCL."
"options.role.tanukiBitCharacter.seconds2" : "Time in the 2-bit stage (seconds)"
"options.role.tanukiBitCharacter.seconds4" : "Time in the 4-bit stage (seconds)"
"options.role.tanukiBitCharacter.seconds8" : "Time in the 8-bit stage (seconds)"
"options.role.tanukiBitCharacter.seconds16" : "Time in the 16-bit stage (seconds)"
"options.role.tanukiBitCharacter.seconds32" : "Time in the 32-bit stage (seconds)"
"options.role.tanukiBitCharacter.seconds64" : "Time in the 64-bit stage (seconds)"
