"role.tanukiTalkative.name" : "Talkative"
"role.tanukiTalkative.short" : "Talk"
"role.tanukiTalkative.blurb" : "Silence is deadly!"
"role.tanukiTalkative.doc" : "Modifier. Die after the configured period of silence. Speech above the microphone threshold resets the timer. The host can enable silence deaths during meetings; otherwise meetings reset the timer. A disconnected BetterCrewLink pauses the timer, and reconnection resumes it. Muting while connected counts as silence. Voice levels use a 0-100 scale: lower values respond to quieter voices; higher values require louder voices."
"options.role.tanukiTalkative.detail" : "A crewmate who must keep speaking to survive."
"options.role.tanukiTalkative.duration" : "Time until silence death"
"options.role.tanukiTalkative.threshold" : "Voice level counted as speech"
"options.role.tanukiTalkative.duringMeeting" : "Silence deaths during meetings"
"role.tanukiTalkative.remaining" : "Speak to survive: remaining"
"role.tanukiTalkative.disconnected" : "BCL disconnected: paused"
"role.tanukiTalkative.paused" : "Silence timer paused"
