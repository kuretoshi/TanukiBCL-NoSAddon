"role.tanukiLimitSpeech.name" : "Limit Speech"
"role.tanukiLimitSpeech.short" : "LS"
"role.tanukiLimitSpeech.blurb" : "Choose your words. Your speaking time is limited!"
"options.role.tanukiLimitSpeech.detail" : "A modifier that consumes its time budget only while speaking."
"role.tanukiLimitSpeech.doc" : "A modifier with a speaking-time budget. Only speech above the configured microphone level consumes it, with meeting consumption configurable (default ON). When OFF, meetings pause consumption. Exhaustion restrictions still apply during meetings. Silence, muting and disconnection pause consumption. Choose a fixed 1-10 minutes or a random whole number from 1-10 when assigned. Exhaustion either mutes your voice or causes suicide. Meetings and reconnecting do not refill the budget. Crewmates earn time by completing tasks; killing roles earn time by successfully killing another player. Each reward defaults to 10 seconds and is configurable. Rewards can exceed the initial budget and restore speech after exhaustion muting. Dead players receive no rewards."
"options.role.tanukiLimitSpeech.random" : "Random speaking time (1-10 minutes)"
"options.role.tanukiLimitSpeech.minutes" : "Speaking time (minutes; random OFF)"
"options.role.tanukiLimitSpeech.action" : "When speaking time runs out"
"options.role.tanukiLimitSpeech.mute" : "Mute own voice"
"options.role.tanukiLimitSpeech.suicide" : "Suicide"
"options.role.tanukiLimitSpeech.threshold" : "Voice level detected as speech"
"role.tanukiLimitSpeech.remaining" : "Speaking time remaining"
"role.tanukiLimitSpeech.expired" : "Speaking time exhausted"
"role.tanukiLimitSpeech.disconnected" : "Waiting for voice connection"
"options.role.tanukiLimitSpeech.taskReward" : "Speaking time added per task (seconds; crewmates)"
"options.role.tanukiLimitSpeech.killReward" : "Speaking time added per successful kill (seconds)"
"options.role.tanukiLimitSpeech.consumeInMeeting" : "Consume speaking time during meetings"
"role.tanukiLimitSpeech.meetingPaused" : "Meeting: timer paused"
"role.tanukiLimitSpeech.extra" : "+{0}s"
