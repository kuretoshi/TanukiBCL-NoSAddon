"role.tanukiWallEar.name" : "Walls Have Ears"
"role.tanukiWallEar.short" : "Ear"
"role.tanukiWallEar.blurb" : "Listen beyond the wall."
"role.tanukiWallEar.generalBlurb" : "Listen beyond the wall."
"role.tanukiWallEar.doc" : "A Crewmate role that places ears. Can also be assigned as a Madmate.<br>Approach one of your ears and press Use to hear nearby voices through walls.<br>You cannot move while listening. Press Release to stop. The Use button appears near the closest reachable ear."
"role.tanukiWallEar.tips" : "Only you can see and use your ears.<br>Meetings stop listening but leave the ears in place.<br>Death, disconnection or losing the role removes your ears.<br>Range, mute, ghost and communication-sabotage voice restrictions still apply.<br>Requires a compatible development build of Tanuki BetterCrewLink."
"options.role.tanukiWallEar.detail" : "Use placed ears to hear nearby voices through walls."
"options.role.tanukiWallEar.maximum" : "Maximum placed ears"
"options.role.tanukiWallEar.cooldown" : "Placement cooldown"
"options.role.tanukiWallEar.range" : "Ear hearing range"
"button.label.tanukiWallEar.place" : "Place ear"
"button.label.tanukiWallEar.use" : "Use"
"button.label.tanukiWallEar.release" : "Release"
