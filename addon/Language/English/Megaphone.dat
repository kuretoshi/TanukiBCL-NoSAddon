"role.tanukiMegaphone.name" : "Megaphone Laser"
"role.tanukiMegaphone.short" : "ML"
"role.tanukiMegaphone.blurb" : "Charge your voice and blast!"
"role.tanukiMegaphone.doc" : "An Impostor who charges voice energy while stationary and can aim during the charge. Fires automatically when time expires. More energy makes the wall-piercing beam wider. Silence or disconnected BCL still fires a thin beam. Meetings and death cancel the charge. Voice levels use a 0-100 scale: lower values respond to quieter voices; higher values require louder voices."
"options.role.tanukiMegaphone.detail" : "Charge voice energy and fire a wall-piercing beam."
"options.role.tanukiMegaphone.cooldown" : "Fire cooldown"
"options.role.tanukiMegaphone.charge" : "Charge time limit"
"options.role.tanukiMegaphone.minWidth" : "Minimum beam width"
"options.role.tanukiMegaphone.maxWidth" : "Maximum beam width"
"options.role.tanukiMegaphone.capacity" : "Seconds at maximum volume to fully charge"
"options.role.tanukiMegaphone.quietDb" : "Voice level to start charging"
"options.role.tanukiMegaphone.loudDb" : "Voice level for fastest charging"
"options.role.tanukiMegaphone.friendlyFire" : "Friendly fire"
"options.role.tanukiMegaphone.normalKill" : "Allow normal kills"
"options.role.tanukiMegaphone.aimMode" : "Fire direction mode"
"options.role.tanukiMegaphone.free" : "Free"
"options.role.tanukiMegaphone.horizontal" : "Left / Right"
"options.role.tanukiMegaphone.cardinal" : "Four directions"
"button.label.tanukiMegaphone.fire" : "Megaphone"
"button.label.tanukiMegaphone.charge" : "Charging"
"button.label.tanukiMegaphone.firing" : "Firing"
"options.role.tanukiMegaphone.voiceRange" : "Warning voice range at full charge"

"options.role.tanukiMegaphone.soundEnabled" : "Enable sound effects"
"options.role.tanukiMegaphone.soundVolume" : "Sound effect volume"

"options.role.tanukiMegaphone.voiceEffect" : "Add echo to recorded voice on firing"
