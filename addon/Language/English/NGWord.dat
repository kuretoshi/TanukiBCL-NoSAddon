"role.tanukiNGWord.name" : "Forbidden Word"
"role.tanukiNGWord.short" : "NG"
"role.tanukiNGWord.blurb" : "One word can cost your life."
"role.tanukiNGWord.generalBlurb" : "One word can cost your life."
"role.tanukiNGWord.doc" : "A modifier that kills you when you say your forbidden word.<br>When enabled, every player receives a random word from the host's UTF-8 list.<br>Your word is displayed at the top of the screen."
"role.tanukiNGWord.tips" : "・Edit TanukiBCL/NGWords.txt before starting a game, one word per line. Optional readings use | separators.<br>・Desktop and .NET clients recognise their own microphone. Only Web/mobile participants are recognised by the host.<br>・Meeting detection is configurable. Lists shorter than the player count reuse words.<br>・Recognition uses the Japanese model. Test unusual words before playing."
"options.role.tanukiNGWord.detail" : "Assign everyone a forbidden word; saying it causes instant death."
"options.role.tanukiNGWord.enabled" : "Assign forbidden words to every player"
"options.role.tanukiNGWord.meetings" : "Recognise forbidden words during meetings"
"role.tanukiNGWord.hud" : "Forbidden word: "
"role.tanukiNGWord.active" : "Listening"
"role.tanukiNGWord.paused" : "Paused"
"role.tanukiNGWord.disconnected" : "Speech recognition unavailable / preparing"
