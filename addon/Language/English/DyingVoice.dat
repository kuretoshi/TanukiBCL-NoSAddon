"role.tanukiDyingVoice.name" : "Dying Voice Message"
"role.tanukiDyingVoice.short" : "Voice"
"role.tanukiDyingVoice.blurb" : "Leave your last words here."
"role.tanukiDyingVoice.generalBlurb" : "Leave your last words here."
"role.tanukiDyingVoice.tips" : "・You are unaware of this modifier while alive.<br>・Your voice is automatically recorded after death and left at that location.<br>・Living players hear a radio-style recording on entering its range; re-entry replays it.<br>・No playback during meetings or for dead listeners.<br>・Microphone mute is respected. Recordings are discarded at game end.<br>・The location icon can be hidden from living players in settings. Ghosts can always see it."
"role.tanukiDyingVoice.doc" : "You are unaware of this modifier while alive.<br>Your voice is automatically recorded after death and left at that location.<br>Living players entering its range hear a radio-style recording."
"options.role.tanukiDyingVoice.detail" : "An unaware modifier that leaves a recorded voice at the death location."
"options.role.tanukiDyingVoice.seconds" : "Recording duration after death"
"options.role.tanukiDyingVoice.range" : "Message playback range"
"role.tanukiDyingVoice.recording" : "Recording your last words: {0}s left"
"options.role.tanukiDyingVoice.showIcon" : "Show location icon to living players"
"options.role.tanukiDyingVoice.loopPlayback" : "Loop recorded message playback"
"role.tanukiDyingVoice.recordingLabel" : "● REC"
